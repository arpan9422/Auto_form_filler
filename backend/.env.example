# Server
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# Database (Docker PostgreSQL)
DATABASE_URL=postgresql://postgres:password123@localhost:5432/form_pilot

# JWT
JWT_SECRET=your-fallback-jwt-secret-here
JWT_ACCESS_SECRET=your-access-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-jwt-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d


# AI Engine Fallback Key (OPTIONAL: Users can input keys securely into PostgreSQL via the UI LLM Gateway without editing this file)
OPENAI_API_KEY=sk-xxx
AICREDITS_API_KEY=your-aicredits-api-key

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name

# GitHub OAuth App (create at github.com/settings/apps)
GITHUB_CLIENT_ID=your-github-app-client-id
GITHUB_CLIENT_SECRET=your-github-app-client-secret
GITHUB_TOKEN=your-github-personal-access-token-for-server-fallback
FRONTEND_URL=http://localhost:3000


CHROMADB_PORT = 8080