# Server
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_form_assistant

# JWT
JWT_SECRET=your-fallback-jwt-secret-here
JWT_ACCESS_SECRET=your-access-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-jwt-secret-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Brevo Email
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=AI Form Assistant

# OpenAI
OPENAI_API_KEY=sk-xxx
AICREDITS_API_KEY=your-aicredits-api-key

# Pinecone
PINECONE_API_KEY=xxx
PINECONE_INDEX=ai-form-assistant

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

# AWS S3
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name
